# URL of the EthRex node with EIP-7906 + EIP-8141 enabled
ETHREX_RPC_URL=http://localhost:8545

# Chain ID configured in EthRex (default 1337 for dev)
ETHREX_CHAIN_ID=1337

# Private key of a funded account on the EthRex node
# For dev nodes this is often a well-known test key
ETHREX_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Hegotá public devnet (EIP-8141 frame transactions + EIP-7906 POST_TX assertions)
# https://github.com/lambdaclass/ethrex/blob/hegota-devnet/scripts/hegota-devnet/USER-GUIDE.md
HEGOTA_RPC_URL=https://rpc1.hegota.ethrex.xyz
HEGOTA_CHAIN_ID=3151908

# Private key for a Hegotá EOA funded via https://faucet.hegota.ethrex.xyz
# WARNING: this key is also embedded in the frontend's client-side bundle (VITE_HEGOTA_PRIVATE_KEY)
# to sign/submit frame transactions directly, since MetaMask cannot represent type-0x06 txs.
# It is publicly visible to anyone loading the page — only ever fund it with testnet ETH.
HEGOTA_PRIVATE_KEY=
