# Private keys embedded in the client-side bundle. Gitignored -- Vite merges this file with
# frontend/.env automatically. Only ever fund these with Hegotá testnet ETH claimed from
# https://faucet.hegota.ethrex.xyz -- they are publicly visible in the shipped JS regardless.

# Written automatically by `npm run deploy:hegota` (scripts/deploy-hegota.mjs).
VITE_HEGOTA_PRIVATE_KEY=

# Separate, well-funded key sponsoring only the Private Swap page's deposit-side faucet button --
# see the matching comment in the root .env.example. Not written by any script.
VITE_HEGOTA_FAUCET_PRIVATE_KEY=
