# --- Hegotá devnet (scripts/deploy-hegota.mjs) ---
# Written automatically by `npm run deploy:hegota`. VITE_HEGOTA_PRIVATE_KEY is a hot
# wallet used to sign EIP-8141 frame transactions directly (MetaMask cannot represent
# type-0x06 txs) — it is bundled into the client-side JS and publicly visible, so it
# must only ever hold Hegotá testnet ETH claimed from https://faucet.hegota.ethrex.xyz.
VITE_HEGOTA_CHAIN_ID=3151908
VITE_HEGOTA_RPC_URL=https://rpc1.hegota.ethrex.xyz
VITE_HEGOTA_PRIVATE_KEY=
# Separate, well-funded key sponsoring only the Private Swap page's deposit-side faucet button --
# see the matching comment in the root .env.example. Testnet funds only, publicly visible.
VITE_HEGOTA_FAUCET_PRIVATE_KEY=
VITE_HEGOTA_TEST_SUBJECT=0x...
VITE_HEGOTA_REQUIRED_EVENT_ASSERTION=0x...
# --- end Hegotá devnet ---
