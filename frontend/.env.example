# --- Hegotá devnet (scripts/deploy-hegota.mjs) ---
# Written automatically by `npm run deploy:hegota`. The two VITE_HEGOTA_*_PRIVATE_KEY values
# (hot wallets used to sign EIP-8141 frame transactions directly, since MetaMask cannot
# represent type-0x06 txs — publicly visible in the shipped JS regardless) live in
# frontend/.env.local, not here. See frontend/.env.local.example.
VITE_HEGOTA_CHAIN_ID=3151908
VITE_HEGOTA_RPC_URL=https://rpc1.hegota.ethrex.xyz
